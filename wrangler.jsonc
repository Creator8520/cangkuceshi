{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "warehouse-workbench-cloud",
  "main": "src/index.js",
  "compatibility_date": "2026-11-25",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "warehouse-workbench",
      "database_id": "993ac184-6310-460b-a214-637380346226",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["*/2 * * * *"]
  }
}
